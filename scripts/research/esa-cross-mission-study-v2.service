[Unit]
Description=ESA cross-mission study v2 with approved channel cadence
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/k_faz/projects/ESA-ADB
ExecStart=/bin/bash /home/k_faz/projects/ESA-ADB/scripts/research/run_cross_mission_study_v2.sh
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2
MemoryAccounting=true
MemoryHigh=10G
MemoryMax=12G
MemorySwapMax=0
OOMPolicy=stop
Nice=5
Restart=no
TimeoutStopSec=30
StandardOutput=append:/home/k_faz/project-backups/run-logs/cross-mission-study-v2-20261120.log
StandardError=append:/home/k_faz/project-backups/run-logs/cross-mission-study-v2-20261120.log

[Install]
WantedBy=default.target
